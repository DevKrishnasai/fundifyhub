{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": [
    "src/server.ts",
    "src/config/**/*",
    "src/api/http/**/*",
    // Only new HTTP layer and server entrypoint
    "src/domain/**/*",
    "src/infra-adapters/**/*",
    "src/socket/**/*",
    "src/types/**/*",
    "src/utils/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
  ],
  "references": [
    { "path": "../../packages/logger" },
    { "path": "../../packages/types" },
    { "path": "../../packages/utils" },
    { "path": "../../packages/prisma" },
    { "path": "../../packages/providers" }
  ]
}