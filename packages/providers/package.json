{
  "name": "@fundifyhub/providers",
  "version": "1.0.0",
  "description": "Provider implementations for payments, storage, and notifications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./payments": {
      "import": "./dist/payments/index.js",
      "require": "./dist/payments/index.js",
      "types": "./dist/payments/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.js",
      "types": "./dist/storage/index.d.ts"
    },
    "./notifications": {
      "import": "./dist/notifications/index.js",
      "require": "./dist/notifications/index.js",
      "types": "./dist/notifications/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "dev": "tsc -b --watch",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fundifyhub/types": "workspace:*",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^1.4.0",
    "ioredis": "^5.4.2",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uploadthing": "^7.4.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "typescript": "^5.3.3"
  }
}
