// ============================================
// PRISMA SETUP
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

// User roles
enum UserRole {
  CUSTOMER
  AGENT
  DISTRICT_ADMIN
  STATE_ADMIN
  COUNTRY_ADMIN
  SUPER_ADMIN
}

// Asset condition
enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

// Auction listing status
enum AuctionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXTENDED
  ENDED
  SOLD
  UNSOLD
  CANCELLED
}

// Auction bid status
enum BidStatus {
  ACTIVE
  OUTBID
  WINNING
  WON
  WITHDRAWN
  REJECTED
  CANCELLED
}

// Asset movement type
enum MovementType {
  INTAKE
  TRANSFER
  AUCTION
  RELEASE
  DISPOSAL
}

// Request stages (high level)
enum RequestStage {
  DRAFT
  REVIEW
  OFFER
  INSPECTION
  DOCUMENTATION
  DISBURSEMENT
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

// Loan lifecycle
enum LoanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

// EMI payment status
enum EMIStatus {
  PENDING
  PAID
  OVERDUE
  DEFAULTED
}

// Inspection status
enum InspectionStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Razorpay order lifecycle
enum PaymentOrderStatus {
  CREATED
  ATTEMPTED
  PAID
  FAILED
  EXPIRED
}

// Document status
enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// Asset lifecycle
enum AssetStatus {
  PLEDGED
  RELEASED
  IN_AUCTION
  FORFEITED
  AUCTIONED
  SOLD
}

// Admin offer status
enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVISED
  CANCELLED
}

// In-app notification categories
enum NotificationCategoryType {
  SECURITY
  TRANSACTIONAL
  REMINDER
  MARKETING
  SYSTEM
}

// In-app notification priority
enum NotificationPriorityLevel {
  CRITICAL
  HIGH
  NORMAL
  LOW
  BULK
}

// ============================================
// GEOGRAPHY
// ============================================

model Country {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String  @unique // ISO code, e.g. "IN"
  isActive Boolean @default(true)

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states State[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@map("countries")
}

model State {
  id        String  @id @default(cuid())
  name      String
  code      String
  countryId String
  isActive  Boolean @default(true)

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country         Country               @relation(fields: [countryId], references: [id], onDelete: Cascade)
  districts       District[]
  userAssignments UserStateAssignment[]

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("states")
}

model District {
  id       String  @id @default(cuid())
  name     String
  code     String
  stateId  String
  isActive Boolean @default(true)

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state           State                    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  warehouses      Warehouse[]
  userAssignments UserDistrictAssignment[]
  homeUsers       User[]                   @relation("HomeDistrict")
  requests        Request[]                @relation("RequestDistrict")

  @@unique([stateId, code])
  @@unique([stateId, name])
  @@index([stateId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("districts")
}

model Warehouse {
  id         String  @id @default(cuid())
  name       String
  code       String  @unique
  districtId String
  address    String?

  latitude  Float?
  longitude Float?

  contactPerson String?
  contactPhone  String?

  capacity     Int?
  currentCount Int  @default(0)

  isActive Boolean @default(true)

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  assets   Asset[]  @relation("AssetCurrentWarehouse")

  movementsFrom AssetMovement[] @relation("MovementFromWarehouse")
  movementsTo   AssetMovement[] @relation("MovementToWarehouse")

  @@index([districtId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([latitude, longitude])
  @@map("warehouses")
}

// ============================================
// USER ASSIGNMENTS
// ============================================

model UserStateAssignment {
  id        String  @id @default(cuid())
  userId    String
  stateId   String
  isPrimary Boolean @default(false)

  assignedAt DateTime @default(now())
  assignedBy String?

  deletedAt DateTime?
  deletedBy String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([userId, stateId])
  @@index([userId])
  @@index([stateId])
  @@index([deletedAt])
  @@map("user_state_assignments")
}

model UserDistrictAssignment {
  id         String  @id @default(cuid())
  userId     String
  districtId String
  isPrimary  Boolean @default(false)

  assignedAt DateTime @default(now())
  assignedBy String?

  deletedAt DateTime?
  deletedBy String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([userId, districtId])
  @@index([userId])
  @@index([districtId])
  @@index([deletedAt])
  @@map("user_district_assignments")
}

// ============================================
// USER + BANK + SESSION
// ============================================

model User {
  id          String @id @default(cuid())
  email       String @unique
  firstName   String
  lastName    String
  phoneNumber String @unique
  password    String              // hashed

  roles UserRole[] @default([CUSTOMER])

  homeDistrictId String?

  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  address String?
  city    String?
  state   String?
  pincode String?

  lastLoginAt      DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  refreshToken     String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeDistrict        District?             @relation("HomeDistrict", fields: [homeDistrictId], references: [id], onDelete: SetNull)
  stateAssignments    UserStateAssignment[]
  districtAssignments UserDistrictAssignment[]

  requests              Request[]           @relation("CustomerRequests")
  assignedRequests      Request[]           @relation("AgentAssignments")
  adminAssignedRequests Request[]           @relation("AdminAssignments")
  comments              Comment[]
  inspections           Inspection[]
  otpVerifications      OTPVerification[]
  inAppNotifications    InAppNotification[]
  auditLogs             AuditLog[]
  sessions              Session[]
  adminOffers           AdminOffer[]        @relation("AdminOffers")
  bankDetails           BankDetails[]

  auctionBids     AuctionBid[]
  wonAuctions     AuctionListing[] @relation("AuctionWinner")
  createdAuctions AuctionListing[] @relation("AuctionCreator")

  @@index([email])
  @@index([phoneNumber])
  @@index([roles])
  @@index([homeDistrictId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model BankDetails {
  id     String @id @default(cuid())
  userId String

  accountNumber String
  ifscCode      String
  accountName   String
  bankName      String?
  branchName    String?

  upiId String?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  isPrimary Boolean @default(false)

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests Request[] @relation("DisbursementAccount")

  @@unique([userId, accountNumber])
  @@index([userId])
  @@index([isPrimary])
  @@index([deletedAt])
  @@map("bank_details")
}

model AdminOffer {
  id          String @id @default(cuid())
  requestId   String
  offeredById String

  offeredAmount Float
  tenureMonths  Int
  interestRate  Float
  processingFee Float @default(0)

  emiAmount     Float?
  totalInterest Float?
  totalAmount   Float?
  emiSchedule   Json?

  penaltyPercentage Float @default(4)
  lateFeePercentage Float @default(0.01)

  status      OfferStatus @default(PENDING)
  expiresAt   DateTime?
  respondedAt DateTime?

  revision        Int     @default(1)
  previousOfferId String?
  notes           String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request       Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offeredBy     User         @relation("AdminOffers", fields: [offeredById], references: [id], onDelete: Restrict)
  previousOffer AdminOffer?  @relation("OfferRevisions", fields: [previousOfferId], references: [id], onDelete: SetNull)
  revisions     AdminOffer[] @relation("OfferRevisions")

  @@index([requestId])
  @@index([offeredById])
  @@index([status])
  @@index([requestId, status])
  @@index([deletedAt])
  @@map("admin_offers")
}

model Session {
  id     String @id @default(cuid())
  userId String

  tokenHash String @unique

  deviceName String?
  deviceType String?
  browser    String?
  os         String?

  ipAddress String?
  city      String?
  country   String?

  isActive       Boolean  @default(true)
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([isActive])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("sessions")
}

// ============================================
// ASSETS + MOVEMENTS + AUCTION
// ============================================

model Asset {
  id String @id @default(cuid())

  assetType    String
  brand        String
  model        String
  condition    AssetCondition @default(GOOD)
  purchaseYear Int
  description  String         @default("")

  estimatedValue Float?
  inspectedValue Float?

  depreciationRate   Float?
  lastValuationDate  DateTime?
  currentMarketValue Float?

  status      AssetStatus @default(PLEDGED)
  warehouseId String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request   Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String     @unique
  warehouse Warehouse? @relation("AssetCurrentWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  movements       AssetMovement[]
  auctionListings AuctionListing[]

  @@index([assetType])
  @@index([status])
  @@index([requestId])
  @@index([warehouseId])
  @@index([condition])
  @@index([deletedAt])
  @@map("assets")
}

model AssetMovement {
  id      String @id @default(cuid())
  assetId String

  movementType    MovementType
  fromWarehouseId String?
  toWarehouseId   String?

  movementDate DateTime @default(now())
  movedBy      String

  notes       String?
  attachments Json?

  verifiedBy String?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset         Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse? @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse   Warehouse? @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([movementType])
  @@index([movementDate])
  @@map("asset_movements")
}

model AuctionListing {
  id            String @id @default(cuid())
  listingNumber String @unique
  assetId       String

  startTime       DateTime
  endTime         DateTime
  extendedEndTime DateTime?

  reservePrice Float
  startingBid  Float
  bidIncrement Float
  buyNowPrice  Float?

  status         AuctionStatus @default(DRAFT)
  currentHighBid Float?
  totalBids      Int           @default(0)

  winnerId     String?
  winningBidId String?
  finalPrice   Float?

  title       String
  description String @db.Text
  mediaUrls   Json?

  termsAndConditions String?   @db.Text
  pickupLocation     String?
  pickupDeadline     DateTime?

  createdById String
  approvedAt  DateTime?
  approvedBy  String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  winner    User?        @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  createdBy User         @relation("AuctionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  bids      AuctionBid[]

  @@index([assetId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([winnerId])
  @@index([createdById])
  @@index([listingNumber])
  @@index([deletedAt])
  @@map("auction_listings")
}

model AuctionBid {
  id        String @id @default(cuid())
  auctionId String
  bidderId  String

  amount Float
  status BidStatus @default(ACTIVE)

  maxAutoBid Float?
  isAutoBid  Boolean @default(false)

  placedAt DateTime  @default(now())
  outbidAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auction AuctionListing @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User           @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([bidderId])
  @@index([status])
  @@index([amount])
  @@index([placedAt])
  @@index([auctionId, amount])
  @@map("auction_bids")
}

// ============================================
// REQUEST + LOAN + EMI + PAYMENT
// ============================================

model Request {
  id              String @id @default(cuid())
  requestNumber   String @unique
  customerId      String
  requestedAmount Float

  districtId String

  stage     RequestStage @default(REVIEW)
  subStatus String?

  requiresCustomerAction Boolean @default(false)
  requiresAdminAction    Boolean @default(true)
  requiresAgentAction    Boolean @default(false)
  isBlocked              Boolean @default(false)

  failureReason  String?
  failureType    String?
  stageChangedAt DateTime?
  stageChangedBy String?

  asset Asset?

  activeOfferId String?

  adminOfferedAmount Float?
  adminTenureMonths  Int?
  adminInterestRate  Float?
  adminEmiSchedule   Json?
  adminProcessingFee Float  @default(0)
  offerMadeDate      DateTime?
  offerResponseDate  DateTime?
  penaltyPercentage  Float  @default(4)
  lateFeePercentage  Float  @default(0.01)

  adminRequestedInfo String?

  disbursementAccountId  String?
  bankDetailsSubmittedAt DateTime?

  assignedAgentId       String?
  assignedAdminId       String?
  inspectionScheduledAt DateTime?

  commentsEnabled Boolean @default(true)

  deletedAt DateTime?
  deletedBy String?

  submittedDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer            User                @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent       User?               @relation("AgentAssignments", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedAdmin       User?               @relation("AdminAssignments", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  district            District            @relation("RequestDistrict", fields: [districtId], references: [id], onDelete: Restrict)
  disbursementAccount BankDetails?        @relation("DisbursementAccount", fields: [disbursementAccountId], references: [id], onDelete: SetNull)
  offers              AdminOffer[]
  loan                Loan?
  comments            Comment[]
  inspections         Inspection[]
  emiSchedules        EMISchedule[]
  payments            Payment[]
  paymentOrders       PaymentOrder[]
  documents           Document[]
  inAppNotifications  InAppNotification[]

  @@index([customerId])
  @@index([stage])
  @@index([stage, subStatus])
  @@index([districtId])
  @@index([assignedAgentId])
  @@index([assignedAdminId])
  @@index([requestNumber])
  @@index([disbursementAccountId])
  @@index([activeOfferId])
  @@index([districtId, stage])
  @@index([customerId, stage])
  @@index([assignedAgentId, stage])
  @@index([requiresCustomerAction])
  @@index([requiresAdminAction])
  @@index([requiresAgentAction])
  @@index([isBlocked])
  @@index([deletedAt])
  @@map("requests")
}

model Loan {
  id         String @id @default(cuid())
  loanNumber String @unique
  requestId  String @unique

  approvedAmount Float
  interestRate   Float
  tenureMonths   Int
  emiAmount      Float

  totalInterest Float
  totalAmount   Float

  status        LoanStatus @default(ACTIVE)
  approvedDate  DateTime
  disbursedDate DateTime?
  firstEMIDate  DateTime
  lastEMIDate   DateTime

  totalPaidAmount Float @default(0)
  remainingAmount Float
  paidEMIs        Int   @default(0)
  remainingEMIs   Int
  overdueEMIs     Int   @default(0)

  transferMethod    String?
  transferReference String?
  transferProof     String?

  closedDate  DateTime?
  closureType String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request            Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  emisSchedule       EMISchedule[]
  payments           Payment[]
  paymentOrders      PaymentOrder[]
  inAppNotifications InAppNotification[]

  @@index([requestId])
  @@index([status])
  @@index([disbursedDate])
  @@index([loanNumber])
  @@index([status, disbursedDate])
  @@index([deletedAt])
  @@map("loans")
}

model EMISchedule {
  id              String    @id @default(cuid())
  loanId          String
  requestId       String
  emiNumber       Int
  dueDate         DateTime
  emiAmount       Float
  principalAmount Float
  interestAmount  Float
  status          EMIStatus @default(PENDING)
  paidDate        DateTime?
  paidAmount      Float?
  lateFee         Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  loan               Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  request            Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  payments           Payment[]
  paymentOrders      PaymentOrder[]
  inAppNotifications InAppNotification[]

  @@unique([loanId, emiNumber])
  @@index([loanId])
  @@index([requestId])
  @@index([dueDate])
  @@index([status])
  @@index([dueDate, status])
  @@index([loanId, status])
  @@map("emi_schedules")
}

model Payment {
  id               String   @id @default(cuid())
  loanId           String
  requestId        String
  emiScheduleId    String?
  amount           Float
  paymentType      String   @default("EMI")
  paymentMethod    String
  paymentReference String
  paidDate         DateTime @default(now())
  processedBy      String
  remarks          String?
  receiptPath      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  request     Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  emiSchedule EMISchedule? @relation(fields: [emiScheduleId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([requestId])
  @@index([emiScheduleId])
  @@index([paidDate])
  @@index([paymentReference])
  @@index([loanId, paidDate])
  @@map("payments")
}

model PaymentOrder {
  id              String @id @default(cuid())
  razorpayOrderId String @unique
  loanId          String
  requestId       String
  emiScheduleId   String
  customerId      String

  emiAmount   Float
  penalty     Float @default(0)
  totalAmount Float

  status        PaymentOrderStatus @default(CREATED)
  attempts      Int                @default(0)
  lastAttemptAt DateTime?

  razorpayPaymentId String?
  razorpaySignature String?
  paymentMethod     String?
  paidAt            DateTime?

  failureReason String?
  failureCode   String?

  notes     Json?
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  request     Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  emiSchedule EMISchedule @relation(fields: [emiScheduleId], references: [id], onDelete: Cascade)

  @@index([razorpayOrderId])
  @@index([loanId])
  @@index([requestId])
  @@index([emiScheduleId])
  @@index([customerId])
  @@index([status])
  @@map("payment_orders")
}

// ============================================
// DOCUMENTS + COMMENTS + INSPECTIONS
// ============================================

model Document {
  id String @id @default(cuid())

  fileKey  String @unique
  fileName String
  fileSize Int
  fileType String

  documentType     String
  documentCategory String @default("OTHER")

  requestId String?

  uploadedBy   String
  uploaderRole String?
  isPublic     Boolean @default(false)

  status DocumentStatus @default(ACTIVE)

  description  String?
  displayOrder Int?
  metadata     Json?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([fileKey])
  @@index([documentType])
  @@index([documentCategory])
  @@index([requestId])
  @@index([uploadedBy])
  @@index([status])
  @@index([deletedAt])
  @@map("documents")
}

model Comment {
  id          String  @id @default(cuid())
  requestId   String
  authorId    String
  content     String
  isInternal  Boolean @default(false)
  commentType String  @default("GENERAL")

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
  @@index([commentType])
  @@index([deletedAt])
  @@map("comments")
}

model Inspection {
  id               String           @id @default(cuid())
  requestId        String
  agentId          String?
  scheduledDate    DateTime?
  completedDate    DateTime?
  status           InspectionStatus @default(PENDING)
  assetCondition   String?
  estimatedValue   Float?
  notes            String?
  recommendApprove Boolean?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  agent   User?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([agentId])
  @@index([status])
  @@index([deletedAt])
  @@map("inspections")
}

// ============================================
// OTP + SERVICE CONFIG + SERIALS
// ============================================

model OTPVerification {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  userId      String?
  identifier  String   // email or phone
  type        String   // "EMAIL" | "PHONE" | ...
  code        String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  isVerified  Boolean  @default(false)
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([identifier])
  @@index([type])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model ServiceConfig {
  id          String  @id @default(cuid())
  serviceName String  @unique
  isEnabled   Boolean @default(false)
  isActive    Boolean @default(false)

  config Json?

  lastConnectedAt  DateTime?
  lastErrorAt      DateTime?
  lastError        String?
  connectionStatus String    @default("DISCONNECTED")
  qrCode           String?   @db.Text

  configuredBy String
  configuredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceName])
  @@index([isEnabled])
  @@index([isActive])
  @@map("service_configs")
}

model SerialCounter {
  id  String @id        // e.g. "REQUEST", "LOAN"
  seq Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("serial_counters")
}

// ============================================
// IN-APP NOTIFICATIONS (DB) + AUDIT LOG
// ============================================

model InAppNotification {
  id     String @id @default(cuid())
  userId String

  title     String
  message   String
  actionUrl String?
  icon      String?

  category NotificationCategoryType  @default(TRANSACTIONAL)
  priority NotificationPriorityLevel @default(NORMAL)

  isRead     Boolean   @default(false)
  readAt     DateTime?
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  requestId     String?
  loanId        String?
  emiScheduleId String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  request     Request?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  loan        Loan?        @relation(fields: [loanId], references: [id], onDelete: SetNull)
  emiSchedule EMISchedule? @relation(fields: [emiScheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([category])
  @@index([requestId])
  @@index([loanId])
  @@map("in_app_notifications")
}

model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  actorEmail String?
  actorRoles String[]

  action     String
  entityType String
  entityId   String?

  description String
  ipAddress   String?
  userAgent   String?

  previousValue Json?
  newValue      Json?
  metadata      Json?

  status       String  @default("SUCCESS")
  errorMessage String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([status])
  @@map("audit_logs")
}
