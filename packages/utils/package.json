{
  "name": "@fundifyhub/utils",
  "version": "1.0.0",
  "description": "Shared utility functions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "test:templates": "ts-node src/__tests__/send-templates.ts"
  },
  "dependencies": {
    "@fundifyhub/types": "workspace:*",
    "bullmq": "^5.63.0",
    "dotenv": "^16.4.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}